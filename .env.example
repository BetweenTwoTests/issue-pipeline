# Copy to .env (gitignored). Never inherited from the shell -- the config
# loader in packages/core throws if these are unset rather than defaulting
# to localhost:7233, so a bare shell env can't accidentally point the
# worker/CLI at the wrong Temporal (e.g. one running for another project).
# The transcript viewer's pipelines panel reads these too (it answers 503
# instead of throwing when they're unset).
TEMPORAL_ADDRESS=localhost:7833
TEMPORAL_NAMESPACE=issue-pipeline

# Must be an ABSOLUTE path (see pipeline.example.yaml at repo root to copy
# from) -- activities run with cwd set to whichever package invoked them
# (e.g. apps/worker), not the repo root, so a relative path resolves wrong.
PIPELINE_CONFIG_PATH=/absolute/path/to/issue-pipeline/pipeline.yaml

# The app's own Postgres (docker: ipl-app-postgres on 5434) -- a separate
# server from Temporal's postgres, so app schema changes never touch
# workflow history. This is the issue tracker's source of truth (issues,
# sub-issues, comments, labels; schema in packages/store). Read by the
# worker's tracker activities AND apps/server. `just db-migrate` applies
# migrations.
APP_DATABASE_URL=postgresql://issue_pipeline:issue_pipeline@localhost:5434/issue_pipeline

# Base URL of the web app (`just web`). Read in two places: the frontend
# dev server takes its port from it, and the worker builds the "Agent
# session transcript" links appended to tracker comments from it -- one
# variable moves both. The links resolve only on this machine (the app is
# loopback-only by design). Optional; unset means this default:
# PIPELINE_VIEWER_URL=http://localhost:8845

# Base URL of the backend API (`just server`). The frontend dev server
# proxies /api/* to it; the server takes its listen port from it. Optional;
# unset means this default:
# PIPELINE_API_URL=http://localhost:8846
